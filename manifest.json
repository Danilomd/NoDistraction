{
  "manifest_version": 3,
  "name": "Focus Chrome",
  "version": "1.0",
  "description": "Bloqueia sites que tiram seu foco",

  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/NoDistraction16.png",
      "32": "icons/NoDistraction32.png",
      "48": "icons/NoDistraction48.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/NoDistraction16.png",
    "32": "icons/NoDistraction32.png",
    "48": "icons/NoDistraction48.png",
    "128": "icons/NoDistraction128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
